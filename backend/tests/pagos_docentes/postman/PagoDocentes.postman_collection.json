                "finance",
                "payments",
                "lookups"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Colecciones de docentes, períodos y carreras', function () {",
                  "  const body = pm.response.json();",
                  "  ['docentes','periodos','carreras'].forEach(function (key) { pm.expect(body[key]).to.be.an('array'); });",
                  "  body.docentes.forEach(function (item) { pm.expect(item.id_docente).to.be.a('number'); pm.expect(item.nombre).to.be.a('string'); });",
                  "  body.periodos.concat(body.carreras).forEach(function (item) { pm.expect(item.id).to.be.a('number'); pm.expect(item.nombre).to.be.a('string'); });",
                  "});",
                  "pm.test('Tiempo menor a 3 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listado paginado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/finance/payments?page=1&page_size={{pageSize}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "finance",
                "payments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "{{pageSize}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contrato de paginación', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.total).to.be.a('number');",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.page_size).to.eql(Number(pm.collectionVariables.get('pageSize')));",
                  "});",
                  "pm.test('Tiempo menor a 3 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                ]
              }
            }
          ]
        },
