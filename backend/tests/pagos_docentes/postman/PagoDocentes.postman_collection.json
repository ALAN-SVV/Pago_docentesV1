{
  "info": {
    "_postman_id": "ffbc703c-4c75-4af6-a70a-c52f45eeefdc",
    "name": "ITQ Conecta - Pagos docentes",
    "description": "Smoke tests de solo lectura y validaciones negativas para la API de Pagos a Docentes. Importa tambien PagoDocentes.local.postman_environment.json y selecciona ese entorno. La coleccion no crea, actualiza ni elimina pagos.\n\nImportante: el router actual no exige JWT y algunas escrituras reciben id_usuario como query param. No expongas la API a usuarios finales ni uses datos de produccion hasta reemplazar ese stub por autenticacion/autorizacion central. Los GET incluidos son de solo lectura.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "pageSize",
      "value": "20"
    }
  ],
  "item": [
    {
      "name": "Smoke tests - solo lectura",
      "item": [
        {
          "name": "Resumen financiero",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/finance/payments/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "finance",
                "payments",
                "summary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Contrato del resumen', function () {",
                  "  const body = pm.response.json();",
                  "  ['total','borradores','listos','por_pagar','pagados','en_mora','listos_atrasados','monto_pendiente','monto_pagado'].forEach(function (key) { pm.expect(body).to.have.property(key); });",
                  "  ['total','borradores','listos','por_pagar','pagados','en_mora','listos_atrasados'].forEach(function (key) { pm.expect(body[key]).to.be.a('number'); pm.expect(body[key]).to.be.at.least(0); });",
                  "});",
                  "pm.test('Tiempo menor a 3 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Seguridad: rechazar bearer inválido (falla actualmente)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token-invalido-de-prueba"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/finance/payments/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "finance",
                "payments",
                "summary"
              ]
            },
            "description": "Prueba de regresión de autenticación. Debe devolver 401 o 403; durante la revisión local respondió 200, por lo que esta prueba queda marcada como falla conocida hasta integrar JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bearer inválido debe rechazarse con 401 o 403', function () {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Alertas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/finance/payments/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "finance",
                "payments",
                "alerts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta es una lista JSON', function () { pm.response.to.be.json; pm.expect(pm.response.json()).to.be.an('array'); });",
                  "pm.test('Forma de cada alerta', function () {",
                  "  pm.response.json().forEach(function (item) {",
                  "    ['id_modulo','docente','tipo','estado','fecha_referencia','dias_transcurridos','umbral','unidad'].forEach(function (key) { pm.expect(item).to.have.property(key); });",
                  "  });",
                  "});",
                  "pm.test('Tiempo menor a 3 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Configuración de umbral",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/finance/payments/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "finance",
                "payments",
                "settings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contrato y valores válidos', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.valor).to.be.a('number').and.to.be.above(0);",
                  "  pm.expect(['DIAS','MESES']).to.include(body.unidad);",
                  "  pm.expect(body).to.have.property('correo_notificacion');",
                  "});",
                  "pm.test('Tiempo menor a 3 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Opciones para el formulario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/finance/payments/lookups",
              "host": [
